# Copy to .env (never commit .env)
DB_USER=finance
DB_PASSWORD=change-me-db
# at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# shared secret between backend and ai-service
AI_INTERNAL_KEY=change-me-internal-key
# optional: enables the LLM answer mode in /api/ai/chat (rule-based answers are used if empty)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
# demo/admin users + sample data. Set false in production.
SEED_DEMO=true
